<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;src/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="image-removebg-preview.png" />
    <Resource Include="image-removebg-preview.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\" />
    <Folder Include="Database\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src/**/*.cs;tests/**/*.cs;Models/*.cs" />
    <Compile Include="Models/CalendarDay.cs" />
    <Page Remove="src/**/*.xaml;tests/**/*.xaml" />
    <ProjectReference Include="src/LernPlaner.Core/LernPlaner.Core.csproj" />
  </ItemGroup>
</Project>
