<Page x:Class="App_LernPlaner.Views.Teacher.TaskEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Zurück zu Aufgaben" Background="Transparent" Foreground="#94A3B8"
                BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,16" Click="BtnBack_Click"/>

        <StackPanel Grid.Row="1" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock x:Name="LblHeader" Text="Neue Aufgabe" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Titel" Foreground="#94A3B8"/>
            <TextBox x:Name="TxtTitle" Height="32" Margin="0,4,0,12" Padding="6,4" Background="#1E293B" Foreground="White" BorderBrush="#334155"/>

            <TextBlock Text="Fach" Foreground="#94A3B8"/>
            <TextBox x:Name="TxtSubject" Height="32" Margin="0,4,0,12" Padding="6,4" Background="#1E293B" Foreground="White" BorderBrush="#334155"/>

            <TextBlock Text="Beschreibung" Foreground="#94A3B8"/>
            <TextBox x:Name="TxtDescription" Height="80" Margin="0,4,0,12" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="#1E293B" Foreground="White" BorderBrush="#334155"/>

            <TextBlock Text="Klasse" Foreground="#94A3B8"/>
            <ComboBox x:Name="CmbClass" DisplayMemberPath="Name" Height="32" Margin="0,4,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Priorität" Foreground="#94A3B8"/>
                    <ComboBox x:Name="CmbPriority" Height="32" Margin="0,4,0,0">
                        <ComboBoxItem Content="Niedrig" Tag="1"/>
                        <ComboBoxItem Content="Mittel" Tag="2" IsSelected="True"/>
                        <ComboBoxItem Content="Hoch" Tag="3"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="Deadline" Foreground="#94A3B8"/>
                    <DatePicker x:Name="DpDeadline" Height="32" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Speichern" Padding="16,8" Background="#0EA5E9" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>
                <Button x:Name="BtnDelete" Content="Löschen" Padding="16,8" Margin="10,0,0,0" Background="#7F1D1D" Foreground="White"
                        BorderThickness="0" Visibility="Collapsed" Click="BtnDelete_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
