<Page x:Class="App_LernPlaner.Views.Teacher.RankingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rangliste" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="0" Text="Schüler nach XP sortiert - eine Orientierungshilfe für die Notengebung." Foreground="#94A3B8" FontSize="12" Margin="0,26,0,16"/>

        <ComboBox x:Name="CmbClass" Grid.Row="1" DisplayMemberPath="Name" Width="280" Height="32" HorizontalAlignment="Left" Margin="0,0,0,16"
                  SelectionChanged="CmbClass_SelectionChanged"/>

        <ListView x:Name="LeaderboardList" Grid.Row="2" Background="Transparent" BorderThickness="0">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="14"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Rank}" Foreground="#0EA5E9" FontWeight="Bold" Width="30" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="{Binding UserName}" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Xp, StringFormat={}{0} XP}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
