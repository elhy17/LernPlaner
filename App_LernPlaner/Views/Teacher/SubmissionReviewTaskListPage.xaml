<Page x:Class="App_LernPlaner.Views.Teacher.SubmissionReviewTaskListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Abgaben &amp; Bewertung" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <ListView x:Name="TasksList" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="14"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Titel}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ClassName}" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Foreground="#0EA5E9" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Run Text="{Binding SubmittedCount, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding GradedCount, Mode=OneWay}"/>
                            <Run Text=" bewertet"/>
                        </TextBlock>
                        <Button Grid.Column="2" Content="Öffnen" Padding="10,6" Background="#334155" Foreground="White"
                                BorderThickness="0" Tag="{Binding TaskId}" Click="BtnOpen_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
