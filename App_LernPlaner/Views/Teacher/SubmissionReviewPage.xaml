<Page x:Class="App_LernPlaner.Views.Teacher.SubmissionReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Zurück" Background="Transparent" Foreground="#94A3B8"
                BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnBack_Click"/>

        <TextBlock Grid.Row="1" x:Name="LblTaskTitle" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <ListView x:Name="SubmissionsList" Grid.Row="2" Background="Transparent" BorderThickness="0">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="14"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StudentName}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LateText}" Foreground="#F87171" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="#0EA5E9" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding Abgabe}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Note (1-6):" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Width="50" Height="28" Padding="4" Text="{Binding Grade, Mode=OneWay}" x:Name="TxtGrade"/>
                            <TextBox Grid.Column="2" Height="28" Padding="4" Margin="10,0" Text="{Binding Feedback, Mode=OneWay}" x:Name="TxtFeedback" Tag="Feedback (optional)"/>
                            <Button Grid.Column="3" Content="Speichern" Padding="10,4" Background="#0EA5E9" Foreground="White"
                                    BorderThickness="0" Tag="{Binding SubmissionId}" Click="BtnSaveGrade_Click"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
