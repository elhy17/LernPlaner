<Page x:Class="App_LernPlaner.Views.Teacher.TaskEditorListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Aufgaben" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Neue Aufgabe" Padding="14,8" Background="#0EA5E9" Foreground="White"
                    BorderThickness="0" Click="BtnNewTask_Click"/>
        </Grid>

        <ListView x:Name="TasksList" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="14"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Titel}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Foreground="#94A3B8" FontSize="11">
                                <Run Text="{Binding Subject, Mode=OneWay}"/>
                                <Run Text=" · Klasse: "/>
                                <Run Text="{Binding ClassName, Mode=OneWay}"/>
                                <Run Text=" · Fällig: "/>
                                <Run Text="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Bearbeiten" Padding="10,6" Margin="0,0,8,0" Background="#334155" Foreground="White"
                                BorderThickness="0" Tag="{Binding TaskId}" Click="BtnEdit_Click"/>
                        <Button Grid.Column="2" Content="Löschen" Padding="10,6" Background="#7F1D1D" Foreground="White"
                                BorderThickness="0" Tag="{Binding TaskId}" Click="BtnDelete_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
