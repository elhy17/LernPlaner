<Page x:Class="App_LernPlaner.Views.Classes.KlassenDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Zurück zu Klassen" Background="Transparent" Foreground="#94A3B8"
                BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,16" Click="BtnBack_Click"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="LblClassName" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="LblMeta" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BtnDeleteClass" Grid.Column="1" Content="Klasse archivieren" Padding="12,6"
                    Background="#7F1D1D" Foreground="White" BorderThickness="0" Click="BtnDeleteClass_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <TextBlock x:Name="LblStats" Foreground="#94A3B8" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3" x:Name="PanelAddStudent" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CmbAddStudent" Grid.Column="0" Height="32" DisplayMemberPath="DisplayText"/>
            <Button Grid.Column="1" Content="Schüler hinzufügen" Margin="10,0,0,0" Padding="12,6"
                    Background="#0EA5E9" Foreground="White" BorderThickness="0" Click="BtnAddStudent_Click"/>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Schüler" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListView x:Name="StudentsList" Background="Transparent" BorderThickness="0">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding UserName}" Foreground="White" VerticalAlignment="Center"/>
                            <!-- FA-10: Lehrer entfernt Schüler aus Klasse -->
                            <Button Grid.Column="1" Content="Entfernen" Padding="8,4" Background="#334155" Foreground="White"
                                    BorderThickness="0" Tag="{Binding UserId}" Click="BtnRemoveStudent_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
