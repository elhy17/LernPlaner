<Page x:Class="App_LernPlaner.Views.Classes.KlassenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Klassen" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button x:Name="BtnCreateClass" Grid.Column="1" Content="+ Neue Klasse"
                    Padding="14,8" Margin="0,0,10,0" Background="#0EA5E9" Foreground="White" BorderThickness="0"
                    Click="BtnCreateClass_Click"/>

            <Button x:Name="BtnJoinClass" Grid.Column="2" Content="Klasse beitreten"
                    Padding="14,8" Background="#1E293B" Foreground="White" BorderThickness="1" BorderBrush="#334155"
                    Click="BtnJoinClass_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,16,0,10">
            <StackPanel x:Name="PanelCreate" Orientation="Horizontal" Visibility="Collapsed">
                <TextBox x:Name="TxtNewClassName" Width="260" Height="32" Padding="6,4" VerticalContentAlignment="Center"/>
                <Button Content="Erstellen" Margin="8,0,0,0" Padding="10,4" Click="BtnConfirmCreate_Click"/>
                <Button Content="Abbrechen" Margin="8,0,0,0" Padding="10,4" Click="BtnCancelCreate_Click"/>
            </StackPanel>

            <StackPanel x:Name="PanelJoin" Orientation="Horizontal" Visibility="Collapsed">
                <TextBox x:Name="TxtJoinCode" Width="180" Height="32" Padding="6,4" VerticalContentAlignment="Center" CharacterCasing="Upper"/>
                <Button Content="Beitreten" Margin="8,0,0,0" Padding="10,4" Click="BtnConfirmJoin_Click"/>
                <Button Content="Abbrechen" Margin="8,0,0,0" Padding="10,4" Click="BtnCancelJoin_Click"/>
            </StackPanel>

            <TextBlock x:Name="LblFormError" Foreground="#F87171" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <ListView x:Name="ClassesList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="16"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TeacherName, StringFormat=Lehrer: {0}}" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StudentCount, StringFormat={}{0} Schüler}" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding TaskCount, StringFormat={}{0} Aufgaben}" Foreground="#94A3B8" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="10,4" Margin="0,0,10,0"
                                Visibility="{Binding ShowJoinCode}">
                            <TextBlock Text="{Binding JoinCode, StringFormat=Code: {0}}" Foreground="#0EA5E9" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Button Grid.Column="3" Content="Details" Padding="10,6" Background="#334155" Foreground="White" BorderThickness="0"
                                Tag="{Binding ClassId}" Click="BtnDetails_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
