<Window x:Class="App_LernPlaner.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login" Background="#F4F7F6"
      Width="1100"
      Height="680"
      MinWidth="900"
      MinHeight="560"
      WindowStyle="None"
      WindowStartupLocation="CenterScreen">

    <Grid Background="#020817">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1.*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="70">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel  Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Border Width="58"
                        Height="58"
                        Background="#0EA5E9"
                        CornerRadius="14">
                    <TextBlock Text="🎓"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Study"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Master"
                                   Foreground="#3B82F6"
                                   FontSize="34"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="#1D4ED8"
                            CornerRadius="8"
                            Padding="10,2"
                            HorizontalAlignment="Left"
                            Margin="10,6,0,0">
                    <TextBlock  Text="Pro"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        Margin="0,20,40,0">
                <Rectangle Width="80"
                           Height="3"
                           Fill="#2563EB"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,34"/>

                <TextBlock Text="Dein Lernen."
                           Foreground="White"
                           FontSize="36"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Deine Aufgaben."
                           Foreground="White"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Text="Dein Fortschritt."
                           Foreground="White"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Text="Organisiere Aufgaben, Deadlines und Lernfortschritt an einem Ort."
                           Foreground="#94A3B8"
                           FontSize="16"
                           TextWrapping="Wrap"
                           LineHeight="26"
                           Margin="0,28,0,0"
                           MaxWidth="520"/>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="StudyMaster Pro"
                       Foreground="#475569"
                       FontSize="13"/>
        </Grid>

        <Grid Grid.Column="1" 
              Margin="40,50,80,70"
              >
            <Border Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="48"
                    VerticalAlignment="Center"
                    MaxWidth="480">

                <StackPanel>
                    <Border Width="78"
                            Height="78"
                            Background="#0EA5E9"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="39"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                        <TextBlock Text="🎓"
                                   FontSize="34"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="Willkommen zurück"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,34"/>
                    <TextBlock Text="Benutzername"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,0,0,8"/>
                    <Border Background="#020817"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="48"
                            Margin="0,0,0,18">
                        <TextBox x:Name="txtUsername"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Padding="14,12"
                                 CaretBrush="White"/>
                    </Border>

                    <TextBlock Text="Passwort"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <Border  Background="#020817"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="48"
                            Margin="0,0,0,10">
                        <PasswordBox x:Name="txtPassword"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontSize="15"
                                     Padding="14,12"
                                     CaretBrush="White"/>
                    </Border>

                    <Button  Content="Passwort vergessen?"
                            HorizontalAlignment="Right"
                            Foreground="#38BDF8"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Click="BtnRecover_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"/>
                        </ControlTemplate>
                    </Button.Template>
                    </Button>

                    <Button Content="Anmelden"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Height="50"
                            FontSize="18"
                            Margin="0,15,0,0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnLogin_Click"/>

                    <TextBlock Text="Neue Konten werden ausschließlich vom IT-Administrator angelegt."
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>
                
            </Border>
        </Grid>

        
    </Grid>
       
</Window>
