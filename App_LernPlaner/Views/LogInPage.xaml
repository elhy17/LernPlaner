<Page x:Class="Nexus_Team.views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login" Background="#F4F7F6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#E2EBF5" CornerRadius="0,30,30,0">
            <StackPanel VerticalAlignment="Center">
                <Image Source="../image-removebg-preview.png" Width="180" Height="191" Margin="0,0,0,20"/>
                <TextBlock Text="Willkommen zurück!" FontSize="22" HorizontalAlignment="Center" Foreground="#333"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="60,0">
            <TextBlock Text="Anmelden" FontSize="28" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <TextBlock Text="Benutzername"/>
            <TextBox x:Name="txtUsername" Height="35" Margin="0,5,0,15" VerticalAlignment="Center" FontSize="18" />

            <TextBlock Text="Passwort"/>
            <PasswordBox x:Name="txtPassword" Height="35" Margin="0,5,0,5" FontSize="16"/>

            <Button Content="Passwort vergessen?" HorizontalAlignment="Right" Foreground="#4A90E2" 
                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                    Click="BtnRecover_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Anmelden" Background="#4A90E2" Foreground="White" FontWeight="Bold"
                    Height="40" Margin="0,20,0,0" Click="BtnLogin_Click"/>

            <TextBlock Text="Neue Konten werden ausschließlich vom IT-Administrator angelegt."
                       Foreground="#888" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Page>