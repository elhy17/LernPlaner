<Page x:Class="App_LernPlaner.Views.Statistics.StatistikPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120"
      MinWidth="820">

    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#243044"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}"
               BasedOn="{StaticResource SidebarScrollBar}"/>
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Statistik"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Text="Dein Lernfortschritt auf einen Blick"
                       Foreground="#94A3B8"
                       FontSize="14"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- SCHUELER -->
        <ScrollViewer x:Name="PanelStudent"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" Background="#173B7A" CornerRadius="10" Margin="0,0,12,0">
                                    <TextBlock Text="↗" Foreground="#60A5FA" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Fortschritt" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18">
                                <TextBlock Text="{Binding ElementName=LblSubmitted, Path=Text, StringFormat={}{0} erledigt}"
                                           Foreground="#3B82F6"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="abgeschlossene Aufgaben"
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Offen" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="LblOpen"
                                               Text="0"
                                               Foreground="#F97316"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#243044"/>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="In Bearbeitung" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="2"
                                               Foreground="#2563EB"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" Background="#0E3B4D" CornerRadius="10" Margin="0,0,12,0">
                                    <TextBlock Text="◷" Foreground="#22D3EE" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Lernzeit" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18">
                                <TextBlock x:Name="LblStudyTime"
                                           Text="0m"
                                           Foreground="#22D3EE"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="gesamt gelernt"
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Background="#0B1120"
                                    BorderBrush="#243044"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Neue Lernzeit erfassen"
                                               Foreground="#CBD5E1"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="TxtMinutes"
                                                 Grid.Column="0"
                                                 Style="{StaticResource DarkInput}"
                                                 ToolTip="Minuten"/>
                                        <TextBox x:Name="TxtNotes"
                                                 Grid.Column="2"
                                                 Style="{StaticResource DarkInput}"
                                                 ToolTip="Notiz"/>
                                        <Button x:Name="BtnLogSession"
                                                Grid.Column="4"
                                                Content="Speichern"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="BtnLogSession_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" Background="#123F25" CornerRadius="10" Margin="0,0,12,0">
                                    <TextBlock Text="★" Foreground="#22C55E" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Leistung" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18">
                                <TextBlock x:Name="LblGrade"
                                           Text="-"
                                           Foreground="#22C55E"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Durchschnitt"
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Bewertet" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="LblSubmitted"
                                               Text="0"
                                               Foreground="#22C55E"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#243044"/>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Pünktlich" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="5"
                                               Foreground="#22C55E"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="38" Height="38" Background="#0F2D52" CornerRadius="10" Margin="0,0,12,0">
                                <TextBlock Text="▤" Foreground="#60A5FA" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Fächer-Übersicht" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="SubjectStatsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Subject}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DetailText}"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding Percentage}"
                                                     Maximum="100"
                                                     Height="9"
                                                     Foreground="{Binding BarBrush}"
                                                     Background="#1F2937"
                                                     BorderThickness="0"
                                                     VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PercentageText}"
                                                   Foreground="{Binding BarBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="SubjectStatsEmptyText"
                                   Text="Noch keine Aufgaben für die Fächer-Statistik vorhanden."
                                   Foreground="#94A3B8"
                                   FontSize="13"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- LEHRER / ADMIN -->
        <StackPanel x:Name="PanelTeacher" Grid.Row="1" Visibility="Collapsed">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Klassenstatistiken" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Abgabequote deiner Klassen" Foreground="#94A3B8" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Noten exportieren"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnExportGrades_Click"/>
            </Grid>

            <ListView x:Name="ClassStatsList"
                      Background="Transparent"
                      BorderThickness="0"
                      MaxHeight="360">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="#111827"/>
                        <Setter Property="BorderBrush" Value="#243044"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Padding" Value="16"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ClassName}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Foreground="#0EA5E9" FontWeight="Bold">
                                <Run Text="{Binding SubmissionRate, Mode=OneWay}"/>
                                <Run Text="% Abgabequote"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Style="{StaticResource StatCard}"
                    Margin="0,16,0,0"
                    x:Name="PanelAdmin"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Systemweite Statistiken"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="LblSystemStats"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
