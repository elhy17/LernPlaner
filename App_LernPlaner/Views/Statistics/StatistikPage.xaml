<Page x:Class="App_LernPlaner.Views.Statistics.StatistikPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Statistik" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- SCHÜLER -->
        <StackPanel x:Name="PanelStudent" Grid.Row="1">
            <UniformGrid Columns="2" Rows="2">
                <Border Background="#1E293B" CornerRadius="10" Margin="0,0,10,10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Offene Aufgaben" Foreground="#64748B" FontSize="12"/>
                        <TextBlock x:Name="LblOpen" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="10" Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Abgegeben" Foreground="#64748B" FontSize="12"/>
                        <TextBlock x:Name="LblSubmitted" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="10" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Durchschnittsnote" Foreground="#64748B" FontSize="12"/>
                        <TextBlock x:Name="LblGrade" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Lernzeit gesamt" Foreground="#64748B" FontSize="12"/>
                        <TextBlock x:Name="LblStudyTime" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Lernzeit erfassen" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Minuten:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtMinutes" Width="80" Height="30" Padding="6,4"/>
                        <TextBlock Text="Notiz:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <TextBox x:Name="TxtNotes" Width="220" Height="30" Padding="6,4"/>
                        <Button x:Name="BtnLogSession" Content="Speichern" Margin="12,0,0,0" Padding="12,4" Background="#0EA5E9" Foreground="White" BorderThickness="0"
                                Click="BtnLogSession_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- LEHRER / ADMIN -->
        <StackPanel x:Name="PanelTeacher" Grid.Row="1" Visibility="Collapsed">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Klassenstatistiken (Abgabequote)" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Noten exportieren" Padding="10,6" Background="#1E293B" Foreground="White"
                        BorderBrush="#334155" BorderThickness="1" Click="BtnExportGrades_Click"/>
            </Grid>
            <ListView x:Name="ClassStatsList" Background="Transparent" BorderThickness="0" MaxHeight="260">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ClassName}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Foreground="#0EA5E9" FontWeight="Bold">
                                <Run Text="{Binding SubmissionRate, Mode=OneWay}"/>
                                <Run Text="% Abgabequote"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,16,0,0" x:Name="PanelAdmin" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Systemweite Statistiken" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="LblSystemStats" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
