<UserControl x:Class="App_LernPlaner.Views.Tasks.AddTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_LernPlaner.Views.Tasks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#99000000">
        <Border Width="720"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Neue Aufgabe"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontSize="23"
                               FontWeight="Bold"/>

                    <Button Grid.Column="1"
                            Content="X"
                            Height="36"
                            Width="36"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"
                            FontSize="18"
                            Cursor="Hand"
                            Command="{Binding CancelNewTaskCommand}"
                            />
                    
                </Grid>
                
                <!-- Formular -->

                <Grid Grid.Row="1" Margin="32,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28 "/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock 
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Text="Titel"
                        Foreground="#CBD5E1"
                        FontSize="14"
                        FontWeight="SemiBold"/>

                    <TextBox Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0B1120"
                             Foreground="White"
                             BorderBrush="#334155"
                             BorderThickness="1"
                             FontSize="15"
                             Padding="12"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Fach"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="Deadline"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <TextBox Grid.Row="3" 
                             Grid.Column="0"
                             Text="{Binding NewTaskSubject, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0B1120"
                             BorderBrush="#334155"
                             Foreground="White"
                             BorderThickness="1"
                             FontSize="15"
                             Padding="12"
                             VerticalContentAlignment="Center"/>

                    <DatePicker Grid.Row="3" 
                                Grid.Column="2"
                                SelectedDate="{Binding NewTaskDeadline}"
                                Background="#0B1120"
                                Foreground="White"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                FontSize="15"
                                />
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Priorität"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="2"
                               Text="Wiederholend"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <ComboBox Grid.Row="5"
                              Grid.Column="0"
                              SelectedIndex="{Binding NewTaskPriorityIndex}"
                              Background="#0B1120"
                              Foreground="White"
                              BorderBrush="#334155"
                              BorderThickness="1"
                              FontSize="15"
                              Padding="8">
                        <ComboBoxItem Content="Niedrig"/>
                        <ComboBoxItem Content="Mittel"/>
                        <ComboBoxItem Content="Hoch"/>
                    </ComboBox>

                    <CheckBox Grid.Row="5" 
                               Grid.Column="2"
                               Content="Diese Aufgabe wiederholt sich"
                              IsChecked="{Binding NewTaskIsRecurring}"
                              Foreground="#CBD5E1"
                              FontSize="14"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="6" 
                               Grid.ColumnSpan="3"
                               Text="Beschreibung / Notizen"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <TextBox Grid.Row="7"
                             Grid.ColumnSpan="3"
                             Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0B1120"
                             Foreground="White"
                             BorderBrush="#334155"
                             BorderThickness="1"
                             FontSize="15"
                             Padding="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>


                    <TextBlock Grid.Row="8"
                               Grid.ColumnSpan="3"
                               Text="Info: Diese Aufgabe ist nur für dich sichtbar."
                               Foreground="#94A3B8"
                               FontSize="13"
                               Margin="0,12,0,0"/>

                   
                </Grid>

                <Grid Grid.Row="2" Margin="32,18,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="Abbrechen"
                            Height="44"
                            Background="#374151"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Command="{Binding CancelNewTaskCommand}"/>

                    <Button Grid.Column="3"
                            Content="Aufgabe speichern"
                            Height="44"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Command="{Binding SaveNewTaskCommand}"/>
                </Grid>
            </Grid>
            
            
            
            
            
        </Border>
    </Grid>
</UserControl>
