<UserControl x:Class="App_LernPlaner.Views.Tasks.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_LernPlaner.Views.Tasks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>

    <Grid Visibility="{Binding DetailViewVisibility}">
        <Border Background="#AA020617"/>
        <Border Width="640"
                MaxWidth="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#121B2B"
                BorderBrush="#3B4658"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="35"
                                  ShadowDepth="0"
                                  Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Aufgabendetails"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <Button Width="34"
                            Height="34"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseTaskDetailsCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="x"
                                   Foreground="#D1D5DB"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="0,26,0,18"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectedTask.Titel}"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTask.Subject}"
                               Foreground="#93B4E7"
                               FontSize="16"
                               TextAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Height="1"
                        Background="#263244"
                        Margin="0,0,0,18"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Deadline" Foreground="#CBD5E1" FontSize="15"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding SelectedTask.Deadline, StringFormat={}{0:dd.MM.yyyy}}"
                               Foreground="White"
                               FontSize="15"/>
                    <TextBlock Grid.Row="1" Text="Priorität" Foreground="#CBD5E1" FontSize="15"/>
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTask.Priority}" Value="1">
                                        <Setter Property="Background" Value="#8FB9A8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTask.Priority}" Value="2">
                                        <Setter Property="Background" Value="#F59E0B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTask.Priority}" Value="3">
                                        <Setter Property="Background" Value="#B94A48"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SelectedTask.PriorityName}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                    </Border>

                    <TextBlock Grid.Row="2" Text="Status" Foreground="#CBD5E1" FontSize="15"/>
                    <Border Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTask.Status}" Value="0">
                                        <Setter Property="Background" Value="#D97706"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTask.Status}" Value="1">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTask.Status}" Value="2">
                                        <Setter Property="Background" Value="#16A34A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SelectedTask.StatusName}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                    </Border>

                    <TextBlock Grid.Row="3" Text="Wiederholend" Foreground="#CBD5E1" FontSize="15"/>
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding SelectedTask.IsRecurring}"
                               Foreground="White"
                               FontSize="15"/>
                    <TextBlock Grid.Row="4" Text="Erstellt von" Foreground="#CBD5E1" FontSize="15"/>
                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{Binding SelectedTask.CreatedByUsername, TargetNullValue=Unbekannt}"
                               Foreground="White"
                               FontSize="15"/>
                </Grid>

                <Border Grid.Row="4"
                        BorderBrush="#263244"
                        BorderThickness="0,1,0,0"
                        Margin="0,18,0,0"
                        Padding="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Content="Schließen"
                                Width="130"
                                Height="42"
                                Margin="0,0,14,0"
                                Command="{Binding CloseTaskDetailsCommand}"
                                Background="#374151"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        
                        <!--Button (Bearbeiten)-->
                        <Button Grid.Column="2"
                                Content="Bearbeiten"
                                Width="130"
                                Height="42"
                                Margin="0,0,14,0"
                                Background="Transparent"
                                Foreground="White"
                                BorderBrush="#2563EB"
                                BorderThickness="1"
                                Cursor="Hand"
                                Command="{Binding EditTaskProgressCommand}"/>
                        
                        <Button Grid.Column="3"
                                Content="Als erledigt markieren"
                                Width="180"
                                Height="42"
                                Command="{Binding MarkTaskAsDoneCommand}"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <Grid Visibility="{Binding EditViewVisibility}">

            <Border Background="#AA020617"/>

            <Border Width="720"
                    MaxWidth="720" 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#121B2B"
                    BorderBrush="#3B4658"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28"
                    >

                <Border.Effect>
                    <DropShadowEffect
                        Color="#000000"
                        BlurRadius="35"
                        ShadowDepth="0"
                        Opacity="0.45"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Mein Forschritt bearbeiten"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <Button Width="34"
                                Height="34" 
                                HorizontalAlignment="Right"
                                Command="{Binding CloseTaskDetailsCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <TextBlock Text="X" 
                                       Foreground="#D1D5DB"
                                       FontSize="18"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>

                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" 
                                Margin="0,26,0,18" 
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedTask.Titel}"
                                   Foreground="White"
                                   FontSize="26" 
                                   FontWeight="Bold" TextAlignment="Center"/>

                        <TextBlock Text="{Binding SelectedTask.Subject}"
                                   Foreground="#93B4E7"
                                   FontSize="16"
                                   TextAlignment="Center" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!--Formular-->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Status -->
                        <TextBlock Grid.Column="0" Grid.Row="0"
                                   Text="Status *" VerticalAlignment="Center"
                                   Foreground="#CBD5E1" FontSize="15"/>

                        <Grid Grid.Row="0" Grid.Column="1"
                              Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Content="Offen"
                                    Command="{Binding SetProgressStatusCommand}"
                                    CommandParameter="0"
                                    Background="{Binding OffenButtonBackground}"
                                    Foreground="White"
                                    BorderBrush="{Binding OffenButtonBorder}"
                                    BorderThickness="1"/>

                            <Button Grid.Column="1"
                                    Content="In Bearbeitung"
                                    Command="{Binding SetProgressStatusCommand}"
                                    CommandParameter="1"
                                    Background="{Binding InBearbeitungButtonBackground}"
                                    Foreground="White"
                                    BorderBrush="{Binding InBearbeitungButtonBorder}" BorderThickness="1"/>

                            <Button Grid.Column="2"
                                    Content="Erlidigt"
                                    Command="{Binding SetProgressStatusCommand}"
                                    Background="{Binding ErledigtButtonBackground}"
                                    Foreground="White"
                                    CommandParameter="2"
                                    BorderBrush="{Binding ErledigtButtonBorder}"
                                    BorderThickness="1"/>

                            
                        </Grid>
                        
                        <!-- Notizen -->
                        <TextBlock Grid.Row="2" 
                                   Grid.Column="0" Margin="0,8,0,0"
                                   Text="Meine Notizen" VerticalAlignment="Top"
                                   Foreground="#CBD5E1" FontSize="15"/>

                        <TextBox Grid.Row="2" 
                                 Grid.Column="1"
                                 Height="90" Text="{Binding ProgressNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F172A"
                                 Foreground="White"
                                 BorderBrush="#3B4658"
                                 BorderThickness="1"
                                 Padding="12"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>


                         <!-- Antwort -->

                        <TextBlock Grid.Row="4" Grid.Column="0" 
                                   Text="Abgabe / Antwort *"
                                   Foreground="#CBD5E1"
                                   FontSize="15"
                                   VerticalAlignment="Top"
                                   Margin="0,8,0,0"/>

                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Height="120"
                                 Text="{Binding ProgressAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F172A"
                                 Foreground="White"
                                 BorderBrush="#3B4658"
                                 BorderThickness="1"
                                 Padding="12"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                        
                        <!-- Lernzeit -->
                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Text="Lernzeit *"
                                   Foreground="#CBD5E1"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>

                        <Grid Grid.Row="6" 
                              Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                  Width="90" 
                                  Height="38"
                                  Text="{Binding LearningMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Background="#0F172A"
                                  Foreground="White"
                                  FontSize="15"
                                  BorderBrush="#3B4658"
                                  BorderThickness="1"
                                  Padding="8"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Minuten"
                                Foreground="#93A4BC"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="Datei"
                                       Foreground="#CBD5E1"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0"/>

                            <TextBox Grid.Column="3" 
                                     Height="38"
                                     Text="{Binding SubmissionFilePath, Mode=TwoWay}"
                                     Background="#0F172A"
                                     Foreground="White"
                                     BorderBrush="#3B4658"
                                     BorderThickness="1"
                                     VerticalAlignment="Center"
                                     IsReadOnly="True"
                                     Padding="9"
                                     />

                            <Button Grid.Column="4"
                                    Content="Datei Wählen"
                                    Height="38"
                                    Margin="12,0,0,0"
                                    Command="{Binding ChooseSubmissionFileCommand}"
                                    Background="#1F2937"
                                    Foreground="White"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Cursor="Hand"/>


                        </Grid>

                       
                        
                        <!-- Info ? -->
                        <TextBlock Grid.Row="8" 
                                   Grid.ColumnSpan="2"
                                   Text="ⓘ Titel, Fach, Deadline und Priorität werden vom Lehrer festgelegt."
                                   FontSize="13"
                                   Foreground="#93A4BC"/>
                        
                        <!-- Button -->

                        <Border Grid.Row="10"
                                Grid.ColumnSpan="2"
                                BorderBrush="#263244"
                                BorderThickness="0,1,0,0"
                                Padding="0,2,0,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1" 
                                        Content="Abbrechen" 
                                        Width="150"
                                        Height="44" 
                                        Command="{Binding CancelEditTaskProgressCommand}"
                                        Background="#374151"
                                        Margin="60,0,0,0"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"/>

                                <Button Grid.Column="2" 
                                        Content="Speichern" 
                                        Width="150"
                                        Height="42"
                                        Command="{Binding SaveTaskProgressCommand}"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"/> 
                            </Grid>

                            

                        </Border>
                        









                    </Grid>
                    
                    
                    
                </Grid>
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
            </Border>




        </Grid>
        
    </Grid>
</UserControl>
