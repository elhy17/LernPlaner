<Page x:Class="App_LernPlaner.Views.KalenderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:App_LernPlaner.Views"
      mc:Ignorable="d" 
      Background="#020817"
     d:DesignHeight="450" d:DesignWidth="800"
      Title="KalenderPage">

    <Grid Background="#020817" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Kalender"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,24"/>

        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="&lt;"
                    Width="46"
                    Height="44"
                    Background="#1E293B"
                    Foreground="White"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    FontSize="18"
                    Cursor="Hand"
                    Command="{Binding PreviousMonthCommand}"
                    />

            <TextBlock  Grid.Column="1"
                       Text="{Binding MonthTitle}"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="18,0" />
            
            <Button Grid.Column="2"
                    Content="&gt;"
                    Width="46"
                    Height="44"
                    Background="#1E293B"
                    Foreground="White"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    FontSize="18"
                    Cursor="Hand"
                    Command="{Binding NextMonthCommand}"
                     />

            <Button Grid.Column="4"
                     Content="Heute"
                    Width="90"
                    Height="44"
                    Margin="12,0,0,0"
                    Background="#1E293B"
                    Foreground="White"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    FontSize="14"
                    Cursor="Hand"
                    Command="{Binding TodayCommand}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Heute" Foreground="#94A3B8" FontSize="14"/>
                    <TextBlock Text="2" Foreground="White" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Aufgaben" Foreground="#94A3B8" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="20" >
                <StackPanel>
                    <TextBlock Text="Diese Woche" Foreground="#94A3B8" FontSize="14"/>
                    <TextBlock Text="5" Foreground="#F97316" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Aufgaben" Foreground="#94A3B8" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="#1E293B" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Überfällig" Foreground="#94A3B8" FontSize="14"/>
                    <TextBlock Text="2" Foreground="#EF4444" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Aufgaben" Foreground="#94A3B8" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="#111827"
                    BorderBrush="#243044"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="7">
                        <TextBlock Text="Montag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dienstag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mittwoch" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Donnerstag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Freitag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Samstag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sonntag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </UniformGrid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding DayBorder}"
                                        BorderThickness="1"
                                        Background="{Binding DayBackground}"
                                        Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DayNumber}"
                                                   Foreground="{Binding DayForeground}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>

                                        <ItemsControl ItemsSource="{Binding Tasks}"
                                                      Margin="0,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8"
                                                            Padding="6,3"
                                                            Margin="0,0,0,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F97316"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                                                        <Setter Property="Background" Value="#2563EB"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}" Value="2">
                                                                        <Setter Property="Background" Value="#16A34A"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Background" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <TextBlock Text="{Binding Titel}"
                                                                   Foreground="White"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#111827"
                    BorderBrush="#243044"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Anstehende Aufgaben"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,18"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UpcomingTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titel}"
                                                       Foreground="White" 
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Foreground="#94A3B8"
                                                       FontSize="12"
                                                       Margin="0,5,0,0">
                                                <Run Text="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Subject}"/>
                                            </TextBlock>    
                                        </StackPanel> 
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
