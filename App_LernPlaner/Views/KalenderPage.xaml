<Page x:Class="App_LernPlaner.Views.KalenderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:App_LernPlaner.Views"
      mc:Ignorable="d" 
      Background="#020817"
     d:DesignHeight="450" d:DesignWidth="800"
      Title="KalenderPage">

    <Grid Background="#020817" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Kalender"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,24"/>

        <!-- Monat Navigation -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="&lt;"
                    Width="46"
                    Height="44"
                    Command="{Binding PreviousMonthCommand}"
                    Background="#1E293B"
                    Foreground="White"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    FontSize="18"
                    Cursor="Hand"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding MonthTitle}"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="18,0"/>

            <Button Grid.Column="2"
                    Content="&gt;"
                    Width="46"
                    Height="44"
                    Command="{Binding NextMonthCommand}"
                    Background="#1E293B"
                    Foreground="White"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    FontSize="18"
                    Cursor="Hand"/>

            <Button Grid.Column="4"
                    Content="Heute"
                    Width="90"
                    Height="44"
                    Command="{Binding TodayCommand}"
                    Background="#1E293B"
                    Foreground="White"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    FontSize="14"
                    Cursor="Hand"/>
        </Grid>

        <!-- Statistik Karten -->
        <Grid Grid.Row="2" Margin="0,-10,0,18" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Heute -->
            <Border Grid.Column="0"
            Background="#111827"
            BorderBrush="#243044"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Heute"
                           Foreground="#94A3B8"
                           FontSize="12"/>

                        <TextBlock Text="Aufgaben"
                           Foreground="#64748B"
                           FontSize="11"
                           Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                       Text="{Binding TodayTaskCount}"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Diese Woche -->
            <Border Grid.Column="2"
            Background="#111827"
            BorderBrush="#243044"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Diese Woche"
                           Foreground="#94A3B8"
                           FontSize="12"/>

                        <TextBlock Text="fällig"
                           Foreground="#64748B"
                           FontSize="11"
                           Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                       Text="{Binding WeekTaskCount}"
                       Foreground="#F97316"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Überfällig -->
            <Border Grid.Column="4"
            Background="#111827"
            BorderBrush="#243044"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Überfällig"
                           Foreground="#94A3B8"
                           FontSize="12"/>

                        <TextBlock Text="offen"
                           Foreground="#64748B"
                           FontSize="11"
                           Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                       Text="{Binding OverdueTaskCount}"
                       Foreground="#EF4444"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
        <!-- Kalender + rechte Aufgabenliste -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Echter Monatskalender -->
            <Border Grid.Column="0"
                    Background="#111827"
                    BorderBrush="#243044"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="7">
                        <TextBlock Text="Montag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dienstag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mittwoch" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Donnerstag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Freitag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Samstag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sonntag" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </UniformGrid>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding DayBorder}"
                                        BorderThickness="1"
                                        Background="{Binding DayBackground}"
                                        Padding="8">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Tageszahl bleibt immer oben -->
                                        <TextBlock Grid.Row="0"
               Text="{Binding DayNumber}"
               Foreground="{Binding DayForeground}"
               FontSize="14"
               FontWeight="SemiBold"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"/>

                                        <!-- Aufgaben darunter -->
                                        <ItemsControl Grid.Row="1"
                  ItemsSource="{Binding VisibleTasks}"
                  Margin="0,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate>
                                                    <Border Height="22"
                        CornerRadius="6"
                        Padding="6,2"
                        Margin="0,0,0,10">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F97316"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                                                        <Setter Property="Background" Value="#2563EB"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}" Value="2">
                                                                        <Setter Property="Background" Value="#16A34A"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Background" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <TextBlock Text="{Binding Titel}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Wenn mehr als 2 Aufgaben da sind -->
                                        <TextBlock Grid.Row="1"
               Text="{Binding MoreTasksText}"
               Foreground="#60A5FA"
               FontSize="10"
               Margin="0,55,0,0"
               Visibility="{Binding MoreTasksVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            
        </Grid>
    </Grid>
</Page>
