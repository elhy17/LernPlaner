<Page x:Class="App_LernPlaner.Views.AufgabenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120" Height="650">

    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="130"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="20,0,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

                <TextBlock Text="Aufgaben"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                    Width="160" Height="40"
                    Cursor="Hand"
                     Background="#0EA5E9"
                    Foreground="White"
                    BorderBrush="White"
                    BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="+ "
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           FontSize="15"/>
                                    <TextBlock Text="Neue Aufgabe"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           FontSize="15"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0EA5E9"/>
                                    <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            <!-- ANSICHT TOGGLE -->
            <StackPanel Grid.Column="2"
        Orientation="Horizontal"
        Margin="20,0,0,0"
        VerticalAlignment="Center">
                <Border Background="#1E293B"
        BorderBrush="#334155"
        BorderThickness="1"
        CornerRadius="8"
        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tabelle (aktiv) -->
                        <Border Background="#0EA5E9"
                CornerRadius="6"
                Width="36" Height="36"
                Cursor="Hand">
                            <TextBlock Text="▦"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"/>
                        </Border>
                        <!-- Kacheln -->
                        <Border Width="36" Height="36"
                Cursor="Hand">
                            <TextBlock Text="⊞"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"/>
                        </Border>
                        <!-- Kanban -->
                        <Border Width="36" Height="36"
                Cursor="Hand">
                            <TextBlock Text="☰"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

            <!-- FILTER TOOLBAR -->
        <Grid Grid.Row="1" Margin="20,0,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Suche -->
                <Border Grid.Column="0"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍"
                               Foreground="#64748B"
                               Margin="10,0,6,0"
                               VerticalAlignment="Center"/>
                        <TextBox Background="Transparent"
                             Foreground="#64748B"
                             BorderThickness="0"
                             Text="Suchen . . ."
                             VerticalAlignment="Center"
                             FontSize="14"
                             CaretBrush="White"
                             Padding="0,8"/>
                    </StackPanel>
                </Border>

                <!-- Filter: Alle (aktiv) -->
                <Border Grid.Column="1"
                    Background="#1E293B"
                    BorderBrush="#0EA5E9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="□ "
                               Foreground="#0EA5E9"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                        <TextBlock Text="Alle"
                               Foreground="#0EA5E9"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    </StackPanel>
                </Border>

            <Button Grid.Column="1" Margin="0,0,8,0" Cursor="Hand"
Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="8" Padding="16,8">
                            <TextBlock Text="Alle" Foreground="#94A3B8"
                   VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Filter: Offen -->
            <Button Grid.Column="2" Margin="0,0,8,0" Cursor="Hand"
        Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="16,8">
                            <TextBlock Text="Offen" Foreground="#94A3B8"
                           VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Filter: In Bearbeitung -->
            <Button Grid.Column="3" Margin="0,0,8,0" Cursor="Hand"
        Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="16,8">
                            <TextBlock Text="In Bearbeitung" Foreground="#94A3B8"
                           VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Filter: Erledigt -->
            <Button Grid.Column="4" Margin="0,0,8,0" Cursor="Hand"
        Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="16,8">
                            <TextBlock Text="Erledigt" Foreground="#94A3B8"
                           VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Filter: Deadline -->
            <Button Grid.Column="5" Cursor="Hand"
        Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="□ " Foreground="#94A3B8"
                               VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="Deadline" Foreground="#94A3B8"
                               VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>

            

            <!-- STATISTIK KARTEN -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B"
                    CornerRadius="10" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Alle Aufgaben" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="12" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="dieses Semester" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1E293B"
                    CornerRadius="10" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Offen" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="4" Foreground="#F97316" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="2 diese Woche fällig" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#1E293B"
                    CornerRadius="10" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="In Bearbeitung" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="3" Foreground="#3B82F6" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="aktiv" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#1E293B"
                    CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Erledigt" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="5" Foreground="#22C55E" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="davon 4 pünktlich" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AUFGABEN TABELLE -->
        <!-- AUFGABEN TABELLE -->
        <Border Grid.Row="4"
        Margin="20,0,20,0"
        Background="#1E293B"
        CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent" Width="6">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#334155" CornerRadius="3"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel>

                    <!-- ÜBERFÄLLIG -->
                    <TextBlock Text="ÜBERFÄLLIG" Foreground="#64748B"
                       FontSize="11" FontWeight="SemiBold" Margin="20,16,0,8"/>

                    <!-- Tabellen Header -->
                    <Grid Margin="20,0,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="AUFGABE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="FACH" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="DEADLINE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="PRIORITÄT" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="STATUS" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Zeile: Mathe Hausaufgaben -->
                    <Border Margin="10,2" Padding="10,12" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mathe Hausaufgaben" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="von Herr Müller" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Mathematik" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠ " Foreground="#F87171" FontSize="12"/>
                                <TextBlock Text="15.06.2026" Foreground="#F87171"/>
                            </StackPanel>
                            <Border Grid.Column="3" Background="#FCA5A5" CornerRadius="20"
                            Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Hoch" Foreground="#7F1D1D" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Column="4" Background="#F97316" CornerRadius="20"
                            Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Offen" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Button Grid.Column="5" Content="Öffnen"
                            Width="90" Height="34" Cursor="Hand"
                            Background="Transparent" Foreground="White"
                            BorderBrush="#475569" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0EA5E9"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Zeile: SQL Übungsblatt -->
                    <Border Margin="10,2" Padding="10,12" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SQL Übungsblatt" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="von Frau Schmidt" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Datenbanken" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠ " Foreground="#F87171" FontSize="12"/>
                                <TextBlock Text="18.06.2026" Foreground="#F87171"/>
                            </StackPanel>
                            <Border Grid.Column="3" Background="#FCA5A5" CornerRadius="20"
                            Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Hoch" Foreground="#7F1D1D" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Column="4" Background="#F97316" CornerRadius="20"
                            Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Offen" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Button Grid.Column="5" Content="Öffnen"
                            Width="90" Height="34" Cursor="Hand"
                            Background="Transparent" Foreground="White"
                            BorderBrush="#475569" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0EA5E9"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- AKTUELL -->
                    <TextBlock Text="AKTUELL" Foreground="#64748B"
                       FontSize="11" FontWeight="SemiBold" Margin="20,16,0,8"/>

                    <!-- Zeile: C# Projekt -->
                    <Border Margin="10,2" Padding="10,12" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="C# Projekt fertigstellen" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="von Herr Müller" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Programmierung" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="20.06.2026" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Background="#FDE68A" CornerRadius="20"
                            Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Mittel" Foreground="#78350F" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Column="4" Background="#2563EB" CornerRadius="20"
                            Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="In Bearbeitung" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Button Grid.Column="5" Content="Öffnen"
                            Width="90" Height="34" Cursor="Hand"
                            Background="Transparent" Foreground="White"
                            BorderBrush="#475569" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0EA5E9"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ERLEDIGT -->
                    <TextBlock Text="ERLEDIGT" Foreground="#64748B"
                       FontSize="11" FontWeight="SemiBold" Margin="20,16,0,8"/>

                    <!-- Zeile: Englisch Vokabeln -->
                    <Border Margin="10,2,10,10" Padding="10,12" CornerRadius="8" Opacity="0.6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Englisch Vokabeln lernen" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="von Frau Koch" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Englisch" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="12.06.2026" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Background="#BBF7D0" CornerRadius="20"
                            Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Niedrig" Foreground="#14532D" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Column="4" Background="#16A34A" CornerRadius="20"
                            Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Erledigt" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Button Grid.Column="5" Content="Details"
                            Width="90" Height="34" Cursor="Hand"
                            Background="#334155" Foreground="White" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#475569"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
    </Page>