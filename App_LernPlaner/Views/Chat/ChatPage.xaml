<Page x:Class="App_LernPlaner.Views.Chat.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kontakte: jeder Benutzer kann jedem Benutzer schreiben -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Chat" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

            <ListView x:Name="ContactsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                      SelectionChanged="ContactsList_SelectionChanged">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Role}" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#EF4444" CornerRadius="8" Padding="6,1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasUnread}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Konversation -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="LblConversationWith" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,0,8" HorizontalAlignment="{Binding Alignment}">
                                <StackPanel MaxWidth="480">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SenderName}" Foreground="#0EA5E9" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#64748B" FontSize="10"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Body}" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="(bearbeitet)" Foreground="#64748B" FontSize="9" Visibility="{Binding EditedVisibility}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding OwnMessageVisibility}">
                                        <Button Content="Bearbeiten" Padding="6,2" FontSize="10" Background="Transparent" Foreground="#94A3B8"
                                                BorderThickness="0" Cursor="Hand" Tag="{Binding MessageId}" Click="BtnEdit_Click"/>
                                        <Button Content="Löschen" Padding="6,2" FontSize="10" Background="Transparent" Foreground="#F87171"
                                                BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" Tag="{Binding MessageId}" Click="BtnDelete_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtMessage" Grid.Column="0" Height="36" Padding="8,6" VerticalContentAlignment="Center"
                         Background="#1E293B" Foreground="White" BorderBrush="#334155" KeyDown="TxtMessage_KeyDown"/>
                <Button Grid.Column="1" Content="Senden" Margin="10,0,0,0" Padding="16,8" Background="#0EA5E9" Foreground="White"
                        BorderThickness="0" Click="BtnSend_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
