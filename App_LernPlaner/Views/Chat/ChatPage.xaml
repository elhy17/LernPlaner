<Page x:Class="App_LernPlaner.Views.Chat.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- KONTAKTE -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Chat" Foreground="White" FontSize="20" FontWeight="Bold" Margin="18,18,18,14"/>

                <!-- Namenssuche: tippt man z.B. "h", werden alle Kontakte gefiltert, deren Name mit h beginnt -->
                <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                        CornerRadius="18" Margin="14,0,14,14" Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Foreground="#64748B" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" Background="Transparent" Foreground="White"
                                 BorderThickness="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 CaretBrush="White" FontSize="13" Padding="0,0,10,0"
                                 TextChanged="TxtSearch_TextChanged"/>
                    </Grid>
                </Border>

                <ListView Grid.Row="2" x:Name="ContactsList" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="ContactsList_SelectionChanged">
                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A2538"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#20345A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                        Background="{Binding AvatarBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LastMessageTimeText}" Foreground="#64748B" FontSize="10"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PreviewText}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="#0EA5E9" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Visibility="{Binding HasUnread}">
                                    <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- KONVERSATION -->
        <Grid Grid.Column="1" x:Name="PanelConversation" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="20,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="19" Background="#2563EB">
                        <TextBlock x:Name="LblConversationInitials" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LblConversationWith" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LblConversationRole" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="{Binding Alignment}" Margin="0,0,0,10" MaxWidth="520">
                                <TextBlock Text="{Binding SenderName}" Foreground="#64748B" FontSize="11"
                                           HorizontalAlignment="{Binding Alignment}" Margin="4,0,4,3"
                                           Visibility="{Binding OtherMessageVisibility}"/>
                                <Border CornerRadius="14" Padding="12,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                    <Setter Property="Background" Value="#0EA5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Body}" Foreground="White" TextWrapping="Wrap" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding TimeText}" Foreground="#CBD5E1" FontSize="10" Opacity="0.8"/>
                                            <TextBlock Text=" · bearbeitet" Foreground="#CBD5E1" FontSize="10" Opacity="0.8"
                                                       Visibility="{Binding EditedVisibility}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="4,4,4,0"
                                            HorizontalAlignment="{Binding Alignment}"
                                            Visibility="{Binding OwnMessageVisibility}">
                                    <Button Content="Bearbeiten" Padding="6,2" FontSize="10" Background="Transparent" Foreground="#94A3B8"
                                            BorderThickness="0" Cursor="Hand" Tag="{Binding MessageId}" Click="BtnEdit_Click"/>
                                    <Button Content="Löschen" Padding="6,2" FontSize="10" Background="Transparent" Foreground="#F87171"
                                            BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" Tag="{Binding MessageId}" Click="BtnDelete_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="18">
                        <TextBox x:Name="TxtMessage" Height="40" Padding="16,0" VerticalContentAlignment="Center"
                                 Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14"
                                 CaretBrush="White" KeyDown="TxtMessage_KeyDown"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="BtnSend" Content="➤" Width="40" Height="40" Margin="10,0,0,0"
                            Background="#0EA5E9" Foreground="White" BorderThickness="0" FontSize="16"
                            Cursor="Hand" Click="BtnSend_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- LEERER ZUSTAND: noch kein Kontakt ausgewählt -->
        <StackPanel Grid.Column="1" x:Name="PanelEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
            <TextBlock Text="Wähle einen Kontakt aus, um zu chatten" Foreground="#64748B" FontSize="14" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Page>
