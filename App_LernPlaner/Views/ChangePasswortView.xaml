<UserControl x:Class="App_LernPlaner.Views.ChangePasswortView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App_LernPlaner.Views"
             mc:Ignorable="d" 
             Background="Transparent"
             >
    <Grid>
        <Border Width="540"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="102"/>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Passwort ändern"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="X"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"
                            FontSize="18"
                            Cursor="Hand"
                            Command="{Binding CancelChangePasswordCommand}"/>
                    
                </Grid>

                <StackPanel Grid.Row="1" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Border Width="70" Height="70"
                            Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="35">

                        <TextBlock Text="🔒"
                                   Foreground="Blue"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        
                    </Border>

                    <TextBlock Text="Aktualisiere dein Konto-Passwort"
                               Foreground="#94A3B8"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />

                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Aktuelles Passwort"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="CurrentPasswordBox"
                                 Height="42"
                                 Background="#0B1120"
                                 Foreground="White"
                                 BorderBrush="#334155"
                                 BorderThickness="1"
                                 Padding="12"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="Neues Passwort"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="NewPasswordBox"
                                 Height="42"
                                 Background="#0B1120"
                                 Foreground="White"
                                 BorderBrush="#334155"
                                 BorderThickness="1"
                                 Padding="12"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"/>

                    <TextBlock Text="Mindestens 8 Zeichen"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Passwort bestätigen"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Height="42"
                                 Background="#0B1120"
                                 Foreground="White"
                                 BorderBrush="#334155"
                                 BorderThickness="1"
                                 Padding="12"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,24,0,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="0" 
                            Content="Abbrechen"
                            Height="44"
                            Background="#111827"
                            Foreground="White"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding CancelChangePasswordCommand}"/>

                    <Button  Grid.Column="2"
                            Content="Speichern"
                            Height="44"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Grid>
            </Grid>  
            
        </Border>
    </Grid>
</UserControl>
