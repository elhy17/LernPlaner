<Page x:Class="App_LernPlaner.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:taskViews="clr-namespace:App_LernPlaner.Views.Tasks"
      Background="#0B1120">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="330"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding GreettingText}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding CurrentDateText}"
                           Grid.Column="1"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <Button Grid.Column="2"
                        Width="40" Height="40"
                        Background="#1F2937"
                        BorderBrush="#374151"
                        BorderThickness="1">
                    <TextBlock Text="🔔"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- STATISTIK KARTEN -->
        <Grid Margin="20" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E"
                    Style="{StaticResource DashboardCard}"
                    Margin="10" BorderBrush="#2A2A2A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Offene Aufgaben" Foreground="#A1A1AA" FontSize="13"/>
                    <TextBlock Text="{Binding OffeneAufgaben}" Foreground="White"
                               FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding FaelligDieseWoche, StringFormat={}{0} fällig diese Woche}" Foreground="#71717A" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#1E1E1E"
                    Style="{StaticResource DashboardCard}"
                    Margin="10" BorderBrush="#2A2A2A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Abgegeben" Foreground="#A1A1AA"/>
                    <TextBlock Text="{Binding Abgegeben}" Foreground="White"
                               FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="davon 16 pünktlich" Foreground="#71717A" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#1E1E1E"
                    Style="{StaticResource DashboardCard}"
                    Margin="10" BorderBrush="#2A2A2A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Durchschnittsnote" Foreground="#A1A1AA"/>
                    <TextBlock Text="{Binding Durchschnittsnote}" Foreground="White"
                               FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="letzten 30 Tage" Foreground="#71717A" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#1E1E1E"
                    Style="{StaticResource DashboardCard}"
                    Margin="10" BorderBrush="#2A2A2A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="XP Gesamt" Foreground="#A1A1AA"/>
                    <TextBlock Text="{Binding XpGesamt}" Foreground="White"
                               FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="Rang 3 in der Klasse" Foreground="#71717A" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- AUFGABEN LISTE -->
        <Grid Grid.Row="2" Margin="0,-15,0,10">
            <Border Margin="10" Background="{StaticResource CardBrush}"
                    CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Aktuelle Aufgaben"
                               Foreground="White" FontSize="17"
                               FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <ListView Grid.Row="1"
          ItemsSource="{Binding Aufgaben}"
          SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
          Background="Transparent"
          BorderThickness="0"
          FontSize="13"
          ScrollViewer.CanContentScroll="True"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.Resources>

                            <!-- Zeilen-Design: Hover + Selection professioneller -->
                            <Style TargetType="ListViewItem">
                                <Setter Property="Height" Value="56"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="8,0">
                                                <GridViewRowPresenter
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Content}"
                                                    Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>           
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#1A2538"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#20345A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Tabellen-Header -->
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="#111827"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#253044"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="38"/>
                                <Setter Property="Padding" Value="8,0"/>
                            </Style>

                            <!-- Scrollbar moderner -->
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="10"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track"
                               IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0"/>
                                                    </Track.DecreaseRepeatButton>

                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="#334155"
                                                    CornerRadius="5"
                                                    Margin="2"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>

                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </ListView.Resources>

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Aufgabe" Width="270">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Titel}"
                                                       Foreground="White" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Fach" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Subject}" Foreground="#9CA3AF"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Deadline" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}"
                                                       Foreground="#9CA3AF"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Priorität" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PriorityName}" Foreground="#9CA3AF"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Status" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4" CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#374151"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="0">
                                                                <Setter Property="Background" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Background" Value="#2563EB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="2">
                                                                <Setter Property="Background" Value="#16A34A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusName}"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Aktion" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ButtonText}"
                                                    Width="120" Height="36"
                                                    Cursor="Hand"
                                                    Background="#2563EB"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.OpenTaskCommand,RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- BENACHRICHTIGUNGEN -->
        <Grid Grid.Row="3">
            <Border Margin="20,-10,15,10"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="BENACHRICHTIGUNGEN"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#A0A0A0" Margin="15,0,0,15"/>
                    <Border Background="#2A2A2A" CornerRadius="8"
                            Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠" FontSize="18"
                                       Foreground="#F4C542" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="12,5,0,0"
                                       Foreground="White" FontSize="14">
                                <Run FontWeight="Bold" Text="Deadline in 24h:"/>
                                <Run Text=" Mathe-Test Kapitel 3 – fällig am 23.05."/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <taskViews:TaskDetailView Grid.RowSpan="4"
                                  Panel.ZIndex="20"
                                  Visibility="{Binding IsTaskDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</Page>
