<Page x:Class="App_LernPlaner.Views.RecoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Wiederherstellen"
      Background="#020817">

    <Page.Resources>
        <Style x:Key="RecoveryTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#020817"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#020817">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="70">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Border Width="58"
                        Height="58"
                        Background="#0EA5E9"
                        CornerRadius="14">
                    <TextBlock Text="SM"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Study"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Master"
                                   Foreground="#3B82F6"
                                   FontSize="34"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="#1D4ED8"
                        CornerRadius="8"
                        Padding="10,2"
                        HorizontalAlignment="Left"
                        Margin="10,6,0,0">
                    <TextBlock Text="Pro"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="0,20,40,0">
                <Rectangle Width="80"
                           Height="3"
                           Fill="#2563EB"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,34"/>

                <TextBlock Text="Kein Problem."
                           Foreground="White"
                           FontSize="36"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Wir helfen dir,"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Text="wieder reinzukommen."
                           Foreground="White"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBlock Text="Gib deine E-Mail-Adresse ein und erhalte ein temporäres Passwort für dein Konto."
                           Foreground="#94A3B8"
                           FontSize="16"
                           TextWrapping="Wrap"
                           LineHeight="26"
                           Margin="0,28,0,0"
                           MaxWidth="520"/>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="StudyMaster Pro"
                       Foreground="#475569"
                       FontSize="13"/>
        </Grid>

        <Grid Grid.Column="1"
              Margin="40,70,80,70">
            <Border Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="48"
                    VerticalAlignment="Center"
                    MaxWidth="480">

                <StackPanel>
                    <Border Width="78"
                            Height="78"
                            Background="#0EA5E9"
                            CornerRadius="39"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                        <TextBlock Text="SM"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Konto wiederherstellen"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Wir erstellen ein temporäres Passwort für dein Konto."
                               Foreground="#94A3B8"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="22"
                               Margin="0,14,0,32"/>

                    <TextBlock Text="E-Mail-Adresse"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <Border Background="#020817"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="48"
                            Margin="0,0,0,24">
                        <TextBox x:Name="txtEmail"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Padding="14,12"
                                 CaretBrush="White"
                                 VerticalContentAlignment="Center"/>
                    </Border>

                    <Button Content="Passwort zurücksetzen"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnReset_Click"/>

                    <Button Content="Zurück zum Login"
                            Style="{StaticResource TextButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,22,0,0"
                            Click="BtnBackToLogin_Click"/>

                    <TextBlock Text="Ändere dein Passwort nach der Anmeldung direkt im Profil."
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,28,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
