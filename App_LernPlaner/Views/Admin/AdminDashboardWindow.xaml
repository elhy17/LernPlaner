<Window x:Class="App_LernPlaner.Views.Admin.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyMaster Pro - Administration"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        ResizeMode="CanResize">

    <Grid>
        <Frame x:Name="MainFrame" Margin="230,0,0,0" NavigationUIVisibility="Hidden" Background="#0B1120"/>

        <Border Width="230" Background="#111827" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="20,25,0,0">
                    <Border Width="42" Height="42" Background="#0EA5E9" CornerRadius="10">
                        <TextBlock Text="🛠" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="StudyMaster" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <Border Background="#7F1D1D" CornerRadius="8" Padding="8,2" Margin="0,5,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="Admin" Foreground="White" FontSize="15"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,10,15,0">
                    <TextBlock Text="VERWALTUNG" Foreground="#6B7280" FontSize="12" Margin="0,0,0,15"/>

                    <Button x:Name="BtnUsers" Style="{StaticResource SidebarButton}" Click="BtnUsers_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Benutzer" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnClasses" Style="{StaticResource SidebarButton}" Click="BtnClasses_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏫" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Klassenübersicht" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRequests" Style="{StaticResource SidebarButton}" Click="BtnRequests_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Anfragen" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Border x:Name="RequestsBadge" Background="#EF4444" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="LblRequestsBadge" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStatistik" Style="{StaticResource SidebarButton}" Click="BtnStatistik_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Statistik" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ALLGEMEIN" Foreground="#6B7280" FontSize="12" Margin="0,16,0,15"/>

                    <Button x:Name="BtnNotifications" Style="{StaticResource SidebarButton}" Click="BtnNotifications_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Benachrichtigungen" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnChat" Style="{StaticResource SidebarButton}" Click="BtnChat_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Chat" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnProfil" Style="{StaticResource SidebarButton}" Click="BtnProfil_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Profil" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Click="BtnLogout_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏻" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Abmelden" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" BorderThickness="1,1,0,0" BorderBrush="#1F2937">
                    <StackPanel Orientation="Horizontal" Margin="15">
                        <Border Width="45" Height="45" Background="#0EA5E9" CornerRadius="25">
                            <TextBlock x:Name="LblInitials" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock x:Name="LblName" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="IT Administrator" Foreground="#9CA3AF" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
