<Page x:Class="App_LernPlaner.Views.Admin.AdminRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Anfragen (an IT-Admin gerichtete Nachrichten)" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <ListView x:Name="RequestsList" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="14"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SenderName}" Foreground="#0EA5E9" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#64748B" FontSize="11"/>
                        </Grid>
                        <TextBlock Text="{Binding Body}" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="360" Height="28" Padding="6,4" Tag="{Binding SenderId}" x:Name="TxtReply"/>
                            <Button Content="Antworten" Margin="8,0,0,0" Padding="10,4" Background="#0EA5E9" Foreground="White"
                                    BorderThickness="0" Tag="{Binding SenderId}" Click="BtnReply_Click"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
