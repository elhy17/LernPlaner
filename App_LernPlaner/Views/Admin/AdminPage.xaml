<Page x:Class="App_LernPlaner.Views.Admin.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0B1120">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Benutzerverwaltung" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Neues Konto" Padding="14,8" Background="#0EA5E9" Foreground="White"
                    BorderThickness="0" Click="BtnNewAccount_Click"/>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="LblSystemStats" Foreground="#94A3B8" FontSize="12" Margin="0,10,0,10" TextWrapping="Wrap"/>

        <TextBox x:Name="TxtSearch" Grid.Row="2" Height="32" Padding="8,4" Margin="0,0,0,14"
                 Background="#1E293B" Foreground="White" BorderBrush="#334155"
                 TextChanged="TxtSearch_TextChanged" Tag="Suche nach Benutzername oder E-Mail..."/>

        <ListView x:Name="UsersList" Grid.Row="3" Background="Transparent" BorderThickness="0">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="12"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Email}" Foreground="#64748B" FontSize="11"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Role}" Foreground="#0EA5E9" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <!-- FA-05: Admin kann Benutzerrollen ändern -->
                        <Button Grid.Column="2" Content="Rolle wechseln" Padding="8,4" Margin="0,0,10,0"
                                Background="#334155" Foreground="White" BorderThickness="0"
                                Tag="{Binding UserId}" Click="ChangeRole_Click"/>

                        <Button Grid.Column="3" Content="{Binding ActiveButtonText}" Padding="8,4"
                                Foreground="White" BorderThickness="0"
                                Background="{Binding ActiveButtonBrush}"
                                Tag="{Binding UserId}" Click="ToggleActive_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
