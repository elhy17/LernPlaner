<Window x:Class="App_LernPlaner.Views.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_LernPlaner.Views.Dashboard"
        mc:Ignorable="d"
        Title="StudyMaster Pro"
        Height="720"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        ResizeMode="CanResize">

    <Grid>
        <Frame x:Name="MainFrame"
           Margin="230,0,0,0"
           NavigationUIVisibility="Hidden"
           Background="#0B1120"
           Content="{Binding CurrentPage}"/>

        <Border Width="230"
        Background="#111827"
        HorizontalAlignment="Left">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Orientation="Horizontal"
                    Margin="20,25,0,0">

                    <Border Width="42"
                    Height="42"
                    Background="#0EA5E9"
                    CornerRadius="10">

                        <TextBlock Text="🎓"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,0,0,0">

                        <TextBlock Text="StudyMaster"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>

                        <Border Background="#1E3A8A"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left">

                            <TextBlock Text="Pro"
                               Foreground="White"
                               FontSize="15"/>
                        </Border>

                    </StackPanel>

                </StackPanel>

                <!-- MENU -->
                <StackPanel Grid.Row="1"
                    Margin="15,10,15,0">

                    <TextBlock Text="HAUPTMENÜ"
                       Foreground="#6B7280"
                       FontSize="12"
                       Margin="0,0,0,15"/>

                    <!-- DASHBOARD -->
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- AUFGABEN -->
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateAufgabenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Aufgaben" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- KALENDER -->
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding KalendarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Kalender" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- STATISTIK -->
                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Statistik" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- KLASSEN -->
                    <TextBlock Text="KLASSEN"
                   Foreground="#6B7280"
                   FontSize="12"
                   Margin="0,8,0,15"/>


                    <!-- KLASSEN -->
                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Meine Klassen" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Gamification" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Click="Aufgaben_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Profil" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                </StackPanel>

                <!-- USER -->
                <Border Grid.Row="2"
                BorderThickness="1,1,0,0"
                BorderBrush="#1F2937">

                    <StackPanel Orientation="Horizontal"
                        Margin="15">

                        <Border Width="45"
                        Height="45"
                        Background="#0EA5E9"
                        CornerRadius="25">

                            <TextBlock Text="MS"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0">

                            <TextBlock Text="Max Schmidt"
                               Foreground="White"
                               FontWeight="SemiBold"/>

                            <TextBlock Text="Schüler - Level 3"
                               Foreground="#9CA3AF"
                               FontSize="12"/>
                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>


        </Border>



    </Grid>
</Window>