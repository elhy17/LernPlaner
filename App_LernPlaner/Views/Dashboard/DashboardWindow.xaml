<Window x:Class="App_LernPlaner.Views.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App_LernPlaner.Views.Dashboard"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="StudyMaster Pro"
        Height="720"
        Width="1280"
        MinHeight="620"
        MinWidth="1050"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        ResizeMode="CanResize"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButton"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#0B1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#050B18"
                BorderBrush="#1F2937"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Border Width="20"
                            Height="20"
                            Background="#0EA5E9"
                            CornerRadius="5">
                        <TextBlock Text="SM"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="StudyMaster Pro"
                               Foreground="#E5E7EB"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="9,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="−"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_Click"/>
                    <Button Content="□"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click"/>
                    <Button Content="×"
                            Style="{StaticResource CloseTitleBarButton}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Frame x:Name="MainFrame"
           Margin="230,0,0,0"
           NavigationUIVisibility="Hidden"
           Background="#0B1120"
           Content="{Binding CurrentPage}"/>

        <Border Width="230"
        Background="#111827"
        HorizontalAlignment="Left">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Orientation="Horizontal"
                    Margin="20,25,0,0">

                    <Border Width="42"
                    Height="42"
                    Background="#0EA5E9"
                    CornerRadius="10">

                        <TextBlock Text="🎓"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,0,0,0">

                        <TextBlock Text="StudyMaster"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>

                        <Border Background="#1E3A8A"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left">

                            <TextBlock Text="Pro"
                               Foreground="White"
                               FontSize="15"/>
                        </Border>

                    </StackPanel>

                </StackPanel>

                <!-- MENU -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,0,12">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBar}"/>
                    </ScrollViewer.Resources>
                <StackPanel Margin="15,0,15,0">

                    <TextBlock Text="HAUPTMENÜ"
                       Foreground="#6B7280"
                       FontSize="12"
                       Margin="0,0,0,15"/>

                    <!-- DASHBOARD -->
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- AUFGABEN -->
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateAufgabenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Aufgaben" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- KALENDER -->
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateKalenderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Kalender" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- STATISTIK -->
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateStatistikCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Statistik" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- KLASSEN -->
                    <TextBlock Text="KLASSEN"
                   Foreground="#6B7280"
                   FontSize="12"
                   Margin="0,8,0,15"/>


                    <!-- KLASSEN -->
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateKlassenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Meine Klassen" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateGamificationCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Gamification" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateNotificationsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Benachrichtigungen" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateChatCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Chat" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Click="Profil_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Profil" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                </StackPanel>
                </ScrollViewer>

                <!-- USER -->
                <Border Grid.Row="2"
                BorderThickness="1,1,0,0"
                BorderBrush="#1F2937">

                    <StackPanel Orientation="Horizontal"
                        Margin="15">

                        <Border Width="45"
                        Height="45"
                        Background="#0EA5E9"
                        CornerRadius="25">

                            <TextBlock Text="{Binding Initials}"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0">

                            <TextBlock Text="{Binding DisplayName}"
                               Foreground="White"
                               FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding RoleLevelText}"
                               Foreground="#9CA3AF"
                               FontSize="12"/>
                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>


        </Border>

        </Grid>

    </Grid>
</Window>
