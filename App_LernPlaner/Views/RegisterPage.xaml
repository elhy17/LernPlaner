<Page x:Class="Nexus_Team.views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Konto anlegen" Background="#F4F7F6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#E8F8F5" CornerRadius="0,30,30,0">
            <StackPanel VerticalAlignment="Center">
                <Image Source="../image-removebg-preview.png" Width="180" Height="191" Margin="0,0,0,20"/>
                <TextBlock Text="Neues Konto anlegen" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock Text="Nur der Administrator kann Konten erstellen." FontSize="13" Foreground="#666"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Button Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnBack_Click" Panel.ZIndex="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="←" FontSize="24" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,10,0"/>
                <TextBlock Text="Zurück" VerticalAlignment="Center" Foreground="#4A90E2"/>
            </StackPanel>
        </Button>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Margin="60,40">
                <TextBlock Text="Konto erstellen" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="Benutzername"/>
                <TextBox x:Name="txtRegUser" Height="30" Margin="0,5,0,10" FontSize="14"/>

                <TextBlock Text="E-Mail Adresse"/>
                <TextBox x:Name="txtEmail" Height="30" Margin="0,5,0,0" FontSize="14"/>
                <TextBlock x:Name="lblEmailError" Text="Bitte geben Sie eine gültige E-Mail-Adresse ein." Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,0,0,10"/>

                <TextBlock Text="Rolle"/>
                <ComboBox x:Name="cbRole" Height="30" Margin="0,5,0,10">
                    <ComboBoxItem Content="Schüler" IsSelected="True"/>
                    <ComboBoxItem Content="Lehrer"/>
                </ComboBox>

                <TextBlock Text="Passwort"/>
                <PasswordBox x:Name="txtPass" Height="30" Margin="0,5,0,0" FontSize="14"/>
                <TextBlock x:Name="lblPassError" Text="Passwort zu schwach (Min. 8 Zeichen, mind. 1 Großbuchstabe, mind. 1 Zahl)." Foreground="Red" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

                <Button Content="Konto anlegen" Background="#2ECC71" Foreground="White"
                        FontWeight="Bold" Height="40" Margin="0,10,0,0" Click="BtnRegister_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
