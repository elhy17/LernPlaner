<Page x:Class="Nexus_Team.views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Konto anlegen"
      Background="#0B1120">

    <Page.Resources>
        <Style x:Key="AdminInputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryAdminButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#93C5FD"
                Cursor="Hand"
                Click="BtnBack_Click"
                Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="←"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="Zurück"
                           FontSize="14"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#111827"
                    BorderBrush="#1F2937"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="34">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="86"
                            Height="86"
                            Background="#0EA5E9"
                            CornerRadius="20"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,28">
                        <TextBlock Text="SM"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Neues Konto anlegen"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Erstelle Schüler- oder Lehrerkonten direkt für StudyMaster Pro."
                               Foreground="#94A3B8"
                               FontSize="15"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               MaxWidth="430"/>

                    <Border Background="#0B1120"
                            BorderBrush="#243044"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,34,0,0"
                            MaxWidth="430"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Admin-Bereich"
                                       Foreground="#E5E7EB"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Nur Administratoren können neue Benutzerkonten erstellen. Das Passwort kann der Benutzer später im Profil ändern."
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="21"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#111827"
                    BorderBrush="#243044"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="38">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="520"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                        <TextBlock Text="Konto erstellen"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Fülle die Pflichtfelder aus und wähle die passende Rolle."
                                   Foreground="#94A3B8"
                                   FontSize="14"
                                   Margin="0,0,0,28"/>

                        <TextBlock Text="Benutzername"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtRegUser"
                                 Style="{StaticResource AdminInputTextBox}"
                                 Margin="0,0,0,18"/>

                        <TextBlock Text="E-Mail Adresse"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtEmail"
                                 Style="{StaticResource AdminInputTextBox}"
                                 Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblEmailError"
                                   Text="Bitte geben Sie eine gültige E-Mail-Adresse ein."
                                   Foreground="#FCA5A5"
                                   FontSize="12"
                                   Visibility="Collapsed"
                                   Margin="2,0,0,14"/>

                        <TextBlock Text="Rolle"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,8"/>
                        <ComboBox x:Name="cbRole"
                                  Style="{StaticResource AdminComboBox}"
                                  Margin="0,0,0,18">
                            <ComboBoxItem Content="Schüler" IsSelected="True"/>
                            <ComboBoxItem Content="Lehrer"/>
                        </ComboBox>

                        <TextBlock Text="Passwort"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="txtPass"
                                     Style="{StaticResource AdminPasswordBox}"
                                     Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblPassError"
                                   Text="Passwort zu schwach: mindestens 8 Zeichen, 1 Großbuchstabe und 1 Zahl."
                                   Foreground="#FCA5A5"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="2,0,0,18"/>

                        <Button Content="Konto anlegen"
                                Style="{StaticResource PrimaryAdminButton}"
                                Click="BtnRegister_Click"
                                Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
