<Page x:Class="App_LernPlaner.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:App_LernPlaner.Views"
      xmlns:profileViews="clr-namespace:App_LernPlaner.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Profil"
                   Grid.Row="0"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="26"
                   VerticalAlignment="Center"/>
        
        <!-- ProfilKopf-->

        <Border Grid.Row="1"
         Background="#111827"
        BorderBrush="#334155"
        BorderThickness="1"
        CornerRadius="8"
        Padding="28"
        Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Width="100" Height="100"
                        CornerRadius="50" 
                        Background="#2563EB"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding Initials}" Foreground="White" 
                               FontSize="36"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}"
                               Foreground="White" 
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding RoleAndClass}"
                               Foreground="#CBD5E1"
                               FontSize="16"
                               Margin="0,6,0,18"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LevelText}"
                           Foreground="#93C5FD"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,42,0"/>

                        <TextBlock Text="{Binding XpText}"
                           Foreground="#93C5FD"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,42,0"/>

                        <TextBlock Text="{Binding RankText}"
                           Foreground="#93C5FD"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

            <!-- ^Persönlich Daten^ -->

        <Grid Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
            Background="#111827"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24">
                <StackPanel>
                    <TextBlock Text="Persönliche Daten"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,22"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Vorname" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FirstName}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nachname" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastName}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Benutzername" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="E-Mail" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Email}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Rolle" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Role}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>


                    </Grid>

                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Background="#111827"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">

                <StackPanel>
                    <TextBlock Text="LernÜbersicht"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                                />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Offene Aufgaben" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OpenTasks}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Erledigte Aufgaben" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FinishedTasks}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Durchschnittsnote" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AverageGrade}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="XP Gesamt" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalXp}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
                
            </Border>
        </Grid>
        
             <!-- Button -->
        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Profil bearbeiten"
                    Height="46"
                    Background="#2563EB"
                    FontSize="14"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Command="{Binding EditProfileCommand}"/>

            <Button Grid.Column="2" 
                    Content="Passwort ändern" 
                    Height="46"
                    Background="#111827"
                    Foreground="#93C5FD"
                    BorderBrush="#2563EB"
                    FontSize="14"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Command="{Binding ChangePasswordCommand}"/>

            <Button Grid.Column="4" 
                    Content="Abmelden"
                    Height="46"
                    Background="#111827"
                    Foreground="#F87171"
                    BorderBrush="#EF4444"
                    BorderThickness="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Command="{Binding LogoutCommand}"/>
        </Grid>

        <profileViews:EditProfileView
    Grid.RowSpan="4"
    Panel.ZIndex="30"
    Visibility="{Binding IsEditProfileOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
    
</Page>
